{
  "name": "astro-starter",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --config astro.config.dev.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.ts --config=playwright.smoke.config.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.5",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/share-tech": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "astro-seo": "^1.2.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "husky": "^9.1.7"
  }
}
