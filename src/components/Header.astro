---
import { Image } from "astro:assets";
import Logo from "@assets/img/logo.svg";

interface Props {
  userURL?: string;
  userAvatar?: string;
}

const { userURL, userAvatar } = Astro.props;
---

<header
  class="absolute top-0 left-0 z-30 flex items-center justify-between w-full xl:w-1/2 h-auto py-5 px-6 md:px-10"
>
  <a
    href="#main-content"
    class="absolute -top-full left-1/2 p-4 bg-olive-800 bevel micro -translate-x-1/2 ease-in-out focus:top-4 transition-all"
    >Skip to main content</a
  >
  <a
    href="/"
    class="flex items-center gap-3 text-accent hover:text-khaki transition-colors"
    aria-label="Go to home page"
  >
    <Logo width={40} height={26} />
    <span class="micro text-khaki-dim hidden sm:inline" aria-hidden="true"
      >WIJP / {new Date().getFullYear()}</span
    >
  </a>
  {
    userURL && (
      <a
        class="group flex items-center gap-3 py-1.5 pl-1.5 pr-4 bg-olive-700/80 bevel micro text-khaki hover:bg-olive-600 active:bevel-inset transition-colors"
        href={userURL}
        target="_blank"
        rel="noopener noreferrer"
      >
        {userAvatar && (
          <Image
            class="size-8 bevel-inset"
            src={userAvatar}
            alt=""
            width={32}
            height={32}
            loading="eager"
          />
        )}
        Steam profile
        <span class="text-accent" aria-hidden="true">↗</span>
      </a>
    )
  }
</header>
