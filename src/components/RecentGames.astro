---
import Section from "@components/Section.astro";
import playTime from "@utils/playTime.js";

interface Game {
  appid?: number;
  name: string;
  playtime_2weeks?: number;
  playtime_forever: number;
}

interface Props {
  games: Game[];
}

const { games } = Astro.props;
const list = games.filter((game) => game.name);
const max = Math.max(1, ...list.map((g) => g.playtime_2weeks ?? 0));
---

<Section headline="Recent Activity" index={3} meta="Last 14 days">
  {
    list.length > 0 ? (
      <ol class="flex flex-col border-t border-olive-800">
        {list.map((game, i) => {
          const recent = game.playtime_2weeks ?? 0;
          const pct = Math.max(4, Math.round((recent / max) * 100));
          return (
            <li class="grid grid-cols-[2.5rem_1fr_auto] items-center gap-x-4 gap-y-2 py-4 border-b border-olive-800 hover:bg-olive-900/60 transition-colors">
              <span class="micro text-khaki-dim" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="font-display font-medium uppercase tracking-wide text-lg md:text-xl leading-tight">
                {game.name}
              </h3>
              <div class="flex flex-col items-end text-right">
                <span class="text-accent font-mono">{playTime(recent)}</span>
                {(game.playtime_forever ?? 0) > 0 && (
                  <span class="micro text-khaki-dim">
                    {playTime(game.playtime_forever ?? 0)} total
                  </span>
                )}
              </div>
              <div
                class="col-start-2 col-span-2 h-1.5 bg-olive-800"
                aria-hidden="true"
              >
                <div class="meter h-full text-accent" style={`width:${pct}%`} />
              </div>
            </li>
          );
        })}
      </ol>
    ) : (
      <p class="micro text-khaki-dim">No activity in the last two weeks.</p>
    )
  }
</Section>
