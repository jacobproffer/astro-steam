---
import Section from "@components/Section.astro";
import ExternalLink from "@components/ExternalLink.astro";
---

<Section headline="Site Information" index={4} meta="Colophon">
  <p class="max-w-prose text-khaki">
    This site is built by <ExternalLink
      url="https://proffer.dev/"
      title="Jacob Proffer"
    /> with <ExternalLink url="https://astro.build/" title="Astro" />, the <ExternalLink
      url="https://steamcommunity.com/dev"
      title="Steam API"
    />, <ExternalLink url="https://tailwindcss.com/" title="Tailwind CSS" />,
    and <ExternalLink
      url="https://www.typescriptlang.org/"
      title="TypeScript"
    />.
  </p>
  <p class="micro text-khaki-dim flex flex-wrap gap-x-3" aria-hidden="true">
    <span>End of file</span><span class="text-accent">//</span><span>Worldwide (SX)</span>
  </p>
</Section>
