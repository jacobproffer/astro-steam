---
/**
 * Decorative barcode generated from a real value (Steam ID, appid, etc.)
 * so the "noise" on the page is actual data.
 */
interface Props {
  value: string;
  height?: number;
  class?: string;
}

const { value, height = 28, class: className } = Astro.props;

const digits = value.replace(/\D/g, "") || "0";
let x = 0;
const bars: { x: number; w: number }[] = [];
for (const d of digits) {
  const n = parseInt(d, 10);
  const w = (n % 3) + 1;
  const gap = ((n * 7) % 3) + 1;
  bars.push({ x, w });
  x += w + gap;
}
const width = x;
---

<svg
  class={className}
  viewBox={`0 0 ${width} ${height}`}
  width={width * 1.5}
  height={height}
  preserveAspectRatio="none"
  aria-hidden="true"
>
  {bars.map((b) => <rect x={b.x} width={b.w} height={height} fill="currentColor" />)}
</svg>
