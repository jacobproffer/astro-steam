---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Grid from "@components/Grid.astro";
import Hero from "@components/Hero.astro";
import Panel from "@components/Panel.astro";
import Section from "@components/Section.astro";
import Information from "@components/Information.astro";
import Backgrounds from "@components/Backgrounds.astro";
const pageTitle = "Page Not Found";
---

<BaseLayout pageTitle={pageTitle}>
  <Header />
  <Grid>
    <Hero
      headline={pageTitle}
      statusClass="text-offline"
      status="The page you are looking for does not exist."
      backdrop="Error 404"
      serial="404"
    />
    <Panel>
      <Section headline="Oops!" index={1} meta="Not found">
        <p>
          Please check the URL or return to the <a class="text-accent underline underline-offset-4" href="/">homepage</a>.
        </p>
      </Section>
      <Information />
    </Panel>
    <Backgrounds currentGame="" />
  </Grid>
</BaseLayout>
